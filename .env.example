# Copy this file to .env and fill in real values. Never commit .env.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=finrisk

# Optional: only needed if you wire up a macro/volatility data provider
# that requires a key (e.g. FRED, Alpha Vantage).
MACRO_API_KEY=
VOLATILITY_API_KEY=
